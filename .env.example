# Copy to .env and fill in. Never commit .env.

# Gemini via Google Cloud (used on Cloud Run; recommended locally)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Current ADK docs read GOOGLE_GENAI_USE_ENTERPRISE; older ADK versions read GOOGLE_GENAI_USE_VERTEXAI.
GOOGLE_GENAI_USE_ENTERPRISE=True
GOOGLE_GENAI_USE_VERTEXAI=True

# Alternative for local development only: AI Studio API key
# GOOGLE_API_KEY=

# Newest generally available Gemini Flash. Re-check before deploying. Never use gemini-2.x (retired 20 Oct 2026).
# memory = in-memory fakes for local dev; gcp = Firestore + Cloud Storage
BREEDERNEAR_BACKEND=memory

BREEDERNEAR_MODEL=gemini-3.8-flash

BREEDERNEAR_BUCKET=your-project-id-breedernear-uploads
BREEDERNEAR_REGION=asia-south1
RATE_LIMIT_PER_HOUR=30
MAX_UPLOAD_MB=5
